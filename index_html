<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vizyon Bank Premium | Mehmet Ali Cerrah</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { --primary: #003366; --secondary: #00a8cc; --success: #28a745; --danger: #dc3545; --light: #f4f7f9; }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; transition: 0.3s; }
        body { background-color: var(--light); }
        .hidden { display: none !important; }

        /* --- GİRİŞ VE DİL --- */
        #loginPage { height: 100vh; display: flex; justify-content: center; align-items: center; background: radial-gradient(circle, #003366 0%, #001122 100%); position: relative; }
        .lang-bar { position: absolute; top: 20px; right: 20px; z-index: 1001; }
        .lang-btn { background: rgba(255,255,255,0.2); color: white; border: 1px solid white; padding: 8px 15px; cursor: pointer; border-radius: 5px; }
        .lang-btn.active { background: var(--secondary); border-color: var(--secondary); }

        .login-box { background: white; padding: 40px; border-radius: 20px; box-shadow: 0 15px 35px rgba(0,0,0,0.4); width: 400px; text-align: center; }
        .input-field { width: 100%; padding: 12px; margin: 10px 0; border: 1px solid #ddd; border-radius: 8px; }
        .btn-main { width: 100%; padding: 12px; background: var(--secondary); color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; }

        /* --- PANEL YAPISI --- */
        .sidebar { width: 280px; height: 100vh; background: var(--primary); position: fixed; left: 0; top: 0; color: white; padding: 30px 20px; display: flex; flex-direction: column; }
        .nav-item { padding: 15px; margin-bottom: 8px; border-radius: 10px; cursor: pointer; border-left: 4px solid transparent; }
        .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.1); border-left-color: var(--secondary); color: var(--secondary); }
        
        .main-content { margin-left: 280px; padding: 40px; min-height: 100vh; display: flex; flex-direction: column; }
        .panel { background: white; padding: 30px; border-radius: 20px; box-shadow: 0 5px 20px rgba(0,0,0,0.05); animation: slideUp 0.4s ease; flex-grow: 1; }
        
        @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

        /* --- KART VE İSTATİSTİK --- */
        .premium-card { background: linear-gradient(135deg, #0f2027, #2c5364); color: white; padding: 25px; border-radius: 15px; width: 350px; margin-bottom: 20px; position: relative; box-shadow: 0 10px 20px rgba(0,0,0,0.2); }
        .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-top: 20px; }
        .stat-box { background: #f8f9fa; padding: 20px; border-radius: 12px; text-align: center; }

        /* --- FOOTER --- */
        footer { background: #001a33; color: white; padding: 30px; text-align: center; margin-top: 50px; border-radius: 10px; font-size: 14px; line-height: 1.6; }
        footer span { color: var(--secondary); font-weight: bold; }
    </style>
</head>
<body>

    <div class="lang-bar">
        <button class="lang-btn active" onclick="setLanguage('tr')">Türkçe</button>
        <button class="lang-btn" onclick="setLanguage('en')">English</button>
    </div>

    <div id="loginPage">
        <div class="login-box">
            <h1 id="l_title" style="color:var(--primary)">Vizyon Bank</h1>
            <p id="l_desc" style="color:#666; margin-bottom:20px;">Güvenli İnternet Şubesi</p>
            <input type="text" id="userInp" class="input-field" placeholder="Müşteri Numarası">
            <input type="password" class="input-field" placeholder="Şifre">
            <button class="btn-main" onclick="enterApp()" id="l_btn">Giriş Yap</button>
        </div>
    </div>

    <div id="app" class="hidden">
        <div class="sidebar">
            <h2 style="margin-bottom:30px; text-align:center;">Vizyon<span>Bank</span></h2>
            <div class="nav-item active" onclick="route('summary', this)" id="m_1">🏠 Özet Paneli</div>
            <div class="nav-item" onclick="route('transfer', this)" id="m_2">💸 Para Transferi</div>
            <div class="nav-item" onclick="route('bills', this)" id="m_3">📑 Fatura Ödeme</div>
            <div class="nav-item" onclick="route('invest', this)" id="m_4">📈 Yatırım / Döviz</div>
            <div class="nav-item" onclick="route('loan', this)" id="m_5">🏦 Kredi Başvurusu</div>
            <div class="nav-item" style="margin-top:auto; color:#ff6b6b;" onclick="location.reload()" id="m_6">🚪 Güvenli Çıkış</div>
        </div>

        <div class="main-content">
            <div id="summary" class="panel">
                <h1 id="h_welcome">Hoş geldin, Mehmet Ali Cerrah</h1>
                <div class="stat-grid">
                    <div class="premium-card">
                        <small>VIZYON PREMIUM CARD</small>
                        <h2 style="margin:20px 0;">**** **** **** 5325</h2>
                        <p>MEHMET ALI CERRAH</p>
                    </div>
                    <div class="stat-box">
                        <p id="s_bal">Kullanılabilir Bakiye</p>
                        <h1 id="mainBal" style="color:var(--primary); margin-top:10px;">₺25.500,00</h1>
                    </div>
                </div>
                <h3 style="margin-top:30px;" id="h_history">Son İşlemler</h3>
                <div id="logs" style="margin-top:10px;"></div>
            </div>

            <div id="transfer" class="panel hidden">
                <h2 id="m_2_h">Para Transferi (EFT/Havale)</h2>
                <input type="text" class="input-field" placeholder="IBAN (TR...)" id="t_iban">
                <input type="number" class="input-field" placeholder="Tutar (₺)" id="t_amt">
                <button class="btn-main" onclick="execute('transfer')">Gönder</button>
            </div>

            <div id="bills" class="panel hidden">
                <h2 id="m_3_h">Fatura Ödeme Merkezi</h2>
                <select id="f_type" class="input-field">
                    <option value="Elektrik Faturası">Elektrik</option>
                    <option value="Su Faturası">Su</option>
                    <option value="İnternet/Türk Telekom">İnternet</option>
                </select>
                <input type="text" class="input-field" placeholder="Abone Numarası">
                <button class="btn-main" onclick="execute('bill')">Ödemeyi Onayla (₺350,00)</button>
            </div>

            <div id="invest" class="panel hidden">
                <h2 id="m_4_h">Döviz ve Altın İşlemleri</h2>
                <div class="stat-box" style="margin-bottom:10px;">USD: <b>₺34,25</b> | EUR: <b>₺37,10</b> | ALTIN: <b>₺2.980</b></div>
                <button class="btn-main" style="background:var(--success)" onclick="execute('invest')">1 Gram Altın Al (₺2.980)</button>
            </div>

            <div id="loan" class="panel hidden">
                <h2 id="m_5_h">Anında Kredi</h2>
                <p>Mevcut Kredi Notunuz: <b style="color:var(--success)">Çok İyi</b></p>
                <input type="range" min="5000" max="100000" style="width:100%; margin:20px 0;">
                <button class="btn-main" onclick="alert('Kredi başvurunuz değerlendirmeye alındı.')">Başvuruyu Tamamla</button>
            </div>

            <footer>
                <p><span>Proje:</span> Bankacılık Yazılımı Arayüz Geliştirme</p>
                <p><span>Öğrenci:</span> Mehmet Ali Cerrah | <span>No:</span> CEN05325</p>
                <p><span>Okul:</span> Uluslararası Vizyon Üniversitesi - Bilgisayar Mühendisliği</p>
                <p><span>Ders:</span> Web Programlama | <span>Hoca:</span> Porf. Dr. Aşkın Demirkol</p>
            </footer>
        </div>
    </div>

    <script>
        let balance = 25500.00;
        let lang = 'tr';

        const dict = {
            tr: {
                l_title: "Vizyon Bank", l_desc: "Güvenli İnternet Şubesi", l_btn: "Giriş Yap",
                m_1: "🏠 Özet Paneli", m_2: "💸 Para Transferi", m_3: "📑 Fatura Ödeme", m_4: "📈 Yatırım / Döviz", m_5: "🏦 Kredi Başvurusu",
                h_welcome: "Hoş geldin, Mehmet Ali Cerrah", s_bal: "Kullanılabilir Bakiye", h_history: "Son İşlemler"
            },
            en: {
                l_title: "Vision Bank", l_desc: "Secure Internet Banking", l_btn: "Login",
                m_1: "🏠 Dashboard", m_2: "💸 Transfer", m_3: "📑 Bill Pay", m_4: "📈 Investing", m_5: "🏦 Loans",
                h_welcome: "Welcome, Mehmet Ali Cerrah", s_bal: "Available Balance", h_history: "Recent Activity"
            }
        };

        function setLanguage(l) {
            lang = l;
            document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active'));
            event.target.classList.add('active');
            Object.keys(dict[l]).forEach(k => { if(document.getElementById(k)) document.getElementById(k).innerText = dict[l][k]; });
        }

        function enterApp() {
            if(document.getElementById('userInp').value === "") return alert("Lütfen Müşteri No giriniz.");
            document.getElementById('loginPage').classList.add('hidden');
            document.getElementById('app').classList.remove('hidden');
        }

        function route(panelId, el) {
            document.querySelectorAll('.panel').forEach(p => p.classList.add('hidden'));
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            document.getElementById(panelId).classList.remove('hidden');
            el.classList.add('active');
        }

        function execute(type) {
            let amount = 0;
            let note = "";

            if(type === 'transfer') {
                amount = parseFloat(document.getElementById('t_amt').value);
                note = "EFT: " + document.getElementById('t_iban').value;
            } else if(type === 'bill') {
                amount = 350;
                note = document.getElementById('f_type').value;
            } else if(type === 'invest') {
                amount = 2980;
                note = "Altın Alımı (1 Gr)";
            }

            if(isNaN(amount) || amount > balance) return alert("Bakiye yetersiz veya hatalı miktar!");

            balance -= amount;
            document.getElementById('mainBal').innerText = "₺" + balance.toLocaleString('tr-TR', {minimumFractionDigits:2});
            
            let log = `<div style="padding:10px; border-bottom:1px solid #eee; color:var(--danger)">-${amount} TL | ${note} | ${new Date().toLocaleTimeString()}</div>`;
            document.getElementById('logs').innerHTML = log + document.getElementById('logs').innerHTML;
            alert("İşlem Başarılı!");
            route('summary', document.getElementById('m_1'));
        }
    </script>
</body>


